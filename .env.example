# Existing store connection. Copy the values from your current deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing order tracking and email features use these server-only variables.
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional AI replies. Catalog search also works without these two values.
# Choose a model available to your OpenAI API project.
OPENAI_API_KEY=
OPENAI_MODEL=
